NODE_ENV=development

PORT=5000

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/fair_drop

REDIS_HOST=localhost
REDIS_PORT=6379

# Must match the URL the frontend runs on (used for CORS)
FRONTEND_URL=http://localhost:5173

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1d
COOKIE_NAME=fair_drop_token
